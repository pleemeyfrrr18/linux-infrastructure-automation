global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files: [/etc/prometheus/alerts.yml]
scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["{{ hostvars[groups['app_servers'][0]].private_ip }}:9100"]
        labels: {instance: app01}
      - targets: ["{{ private_ip }}:9100"]
        labels: {instance: mon01}
  - job_name: application
    metrics_path: /metrics
    static_configs:
      - targets: ["{{ hostvars[groups['app_servers'][0]].private_ip }}:8080"]
        labels: {instance: app01}
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
